.imread(str(image_path))\n        if img is None:\n            return None\n        \n        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n        gray = cv2.equalizeHist(gray)\n        \n        h, w = gray.shape\n        if max(h, w) > MAX_IMAGE_SIZE:\n            scale = MAX_IMAGE_SIZE / max(h, w)\n            gray = cv2.resize(gray, (int(w * scale), int(h * scale)))\n        \n        denoised = cv2.medianBlur(gray, 3)\n        kernel = np.ones((2, 2), np.uint8)\n        dilated = cv2.dilate(denoised, kernel, iterations=1)\n        \n        thresh = cv2.adaptiveThreshold(\n            dilated, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,\n            cv2.THRESH_BINARY, 11, 2\n        )\n        \n        thresh = cv2.fastNlMeansDenoising(thresh, None, 30, 7, 21)\n        thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, np.ones((2, 2), np.uint8))\n        \n        return thresh\n    except Exception:\n        return None\n\n\ndef group_ocr_lines(ocr_results: List[Tuple[List, str, float]], y_threshold: int = 10) -> List[Tuple[float, float, str]]:\n    if not ocr_results:\n        return []\n    \n    lines = []\n    \n    for bbox, text, conf in ocr_results:\n        x_coords = [p[0] for p in bbox]\n        y_coords = [p[1] for p in bbox]\n        y_center = np.mean(y_coords)\n        x_center = np.mean(x_coords)\n        \n        placed = False\n        for line in lines:\n            if abs(line['y'] - y_center) < y_threshold:\n                line['items'].append((bbox, text, conf))\n                line['y'] = (line['y'] + y_center) / 2\n                line['x'] = (line['x'] + x_center) / 2\n                placed = True\n                break\n        \n        if not placed:\n            lines.append({'y': y_center, 'x': x_center, 'items': [(bbox, text, conf)]})\n    \n    lines = sorted(lines, key=lambda x: x['y'])\n    \n    merged_lines = []\n    for line in lines:\n        items = sorted(line['items'], key=lambda x: min(p[0] for p in x[0]))\n        text = \" \".join([t for _, t, _ in items])\n        merged_lines.append((line['y'], line['x'], text))\n    \n    return merged_lines\n\n\ndef normalize_date(date_str: str) -> Optional[str]:\n    if not date_str:\n        return None\n    try:\n        return date_parser.parse(date_str).strftime(\"%d/%m/%Y\")\n    except Exception:\n        return date_str\n\n\ndef is_close_number(text: str, gt_val: float) -> bool:\n    nums = re.findall(r'\\d+\\.\\d{2}', text)\n    for n in nums:\n        try:\n            if abs(float(n) - float(gt_val)) < 0.01:\n                return True\n        except ValueError:\n            pass\n    return False\n\n\ndef extract_total_advanced(lines: List[Tuple[float, float, str]], image_height: int, image_width: int) -> Optional[float]:\n    if not lines:\n        return None\n    \n    for y, x, text in lines:\n        text_lower = text.lower()\n        if \"total\" in text_lower:\n            nums = re.findall(r'\\d+\\.\\d{2}', text)\n            if nums:\n                try:\n                    return float(nums[-1])\n                except ValueError:\n                    pass\n    \n    for i in range(len(lines) - 2):\n        t1 = lines[i][2].lower()\n        t2 = lines[i+1][2].lower()\n        t3 = lines[i+2][2].lower()\n        \n        if \"total\" in t2 and re.search(r'\\d+\\.\\d{2}', t3):\n            try:\n                return float(re.findall(r'\\d+\\.\\d{2}', t3)[0])\n            except ValueError:\n                pass\n    \n    for i in range(len(lines) - 1):\n        y1, x1, text1 = lines[i]\n        y2, x2, text2 = lines[i+1]\n        text1_lower = text1.lower()\n        \n        if re.search(r'\\b(total|tot|amount|amt)\\b', text1_lower):\n            nums = re.findall(r'\\d+\\.\\d{2}', text2 + \" \" + text1)\n            if nums:\n                try:\n                    return float(nums[0])\n                except ValueError:\n                    pass\n    \n    candidates = []\n    \n    for idx, (y, x, text) in e