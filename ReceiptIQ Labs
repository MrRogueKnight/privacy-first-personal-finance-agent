             score += 4.0\n            elif position_score_x > 0.5:\n                score += 2.0\n            \n            if value > 20:\n                score += (y / max(image_height, 1)) * 2.0\n            \n            candidates.append((value, score, y, x, text))\n    \n    if not candidates:\n        all_numbers = []\n        for y, x, text in lines:\n            if re.search(r'\\d{2}[/-]\\d{2}[/-]\\d{2,4}', text):\n                continue\n            nums = re.findall(r'\\d+\\.\\d{2}', text)\n            for num_str in nums:\n                try:\n                    val = float(num_str)\n                    if 0.5 <= val <= 100000:\n                        all_numbers.append((val, y))\n                except ValueError:\n                    continue\n        \n        if all_numbers:\n            return max(all_numbers, key=lambda x: x[1])[0]\n        return None\n    \n    right_side = [\n        (v, y) for (v, s, y, x, text) in candidates\n        if re.search(r'\\d+\\.\\d{2}\\s*$', text)\n    ]\n    \n    if right_side:\n        return max(right_side, key=lambda x: x[0])[0]\n    \n    values = [(v, y) for (v, s, y, x, text) in candidates]\n    if values:\n        largest = max(values, key=lambda x: x[0])\n        if largest[1] > image_height * 0.6:\n            return largest[0]\n    \n    candidates.sort(key=lambda x: (x[1], x[2]), reverse=True)\n    \n    bottom_numbers = [(v, y) for (v, s, y, x, text) in candidates if y > image_height * 0.6]\n    if bottom_numbers:\n        return max(bottom_numbers, key=lambda x: x[1])[0]\n    \n    top_score = candidates[0][1]\n    filtered = [c for c in candidates if c[1] >= top_score - 1.5]\n    best = max(filtered, key=lambda x: x[2])\n    \n    return best[0]\n\n\ndef extract_store_advanced(lines: List[Tuple[float, float, str]], image_width: int) -> Optional[str]:\n    if not lines:\n        return None\n    \n    lines_local = list(lines)\n    \n    if len(lines_local) >= 2:\n        if len(lines_local[0][2]) < 30 and len(lines_local[1][2]) < 30:\n            merged_top = lines_local[0][2] + \" \" + lines_local[1][2]\n            lines_local = [(lines_local[0][0], lines_local[0][1], merged_top)] + lines_local[2:]\n    \n    candidates = []\n    center_x = image_width / 2\n    \n    for idx, (y, x, text) in enumerate(lines_local[:5]):\n        text_clean = text.strip()\n        \n        if len(text_clean) < 3 or len(text_clean) > 50:\n            continue\n        \n        if re.search(r'\\d', text_clean):\n            continue\n        \n        text_lower = text_clean.lower()\n        \n        if re.search(r'(welcome|thank|visit|again)', text_lower):\n            continue\n        \n        if re.search(r'\\b(street|road|jalan|block|no\\.?)\\b', text_lower):\n            continue\n        \n        if re.search(r'(reg|no\\.?|gst|ssm)', text_lower):\n            continue\n        \n        exclude_terms = ['total', 'tax', 'amount', 'date', 'invoice', 'receipt', \n                         'subtotal', 'gst', 'cash', 'change', 'visa', 'mastercard']\n        if any(k in text_lower for k in exclude_terms):\n            continue\n        \n        if re.match(r'^[^A-Za-z]', text_clean):\n            continue\n        \n        score = 0.0\n        \n        score += (5 - idx) * 1.5\n        \n        length = len(text_clean)\n        upper_ratio = sum(c.isupper() for c in text_clean) / (length if length else 1)\n        if upper_ratio > 0.6:\n            score += 2.0\n        elif upper_ratio > 0.3:\n            score += 1.0\n        \n        if len(text_clean.split()) >= 2:\n            score += 1.0\n        \n        if len(text_clean) > 15:\n            score += 1.0\n        \n        distance_from_center = abs(x - center_x) / max(image_width, 1)\n        if distance_from_center < 0.2:\n            score += 2.0\n        \n        business_keywords = ['store', 'mart', 'cafe', 'restaurant', 'hotel', 'inn', \n                             'pharmacy', 'market', 'shop', 'b