ry data available', ha='center', va='center')\n        axes[0, 1].set_title('Spend by Category')\n    \n    # 3. Distribution of total amounts\n    amounts_valid = df[df['total_amount'].notna()]['total_amount']\n    if len(amounts_valid) > 0:\n        axes[1, 0].hist(amounts_valid, bins=20, edgecolor='black', alpha=0.7)\n        axes[1, 0].set_xlabel('Total Amount ($)')\n        axes[1, 0].set_ylabel('Frequency')\n        axes[1, 0].set_title('Distribution of Receipt Totals')\n    else:\n        axes[1, 0].text(0.5, 0.5, 'No amount data available', ha='center', va='center')\n        axes[1, 0].set_title('Receipt Totals Distribution')\n    \n    # 4. Items per receipt\n    axes[1, 1].hist(df['num_items'], bins=20, edgecolor='black', alpha=0.7)\n    axes[1, 1].set_xlabel('Number of Items')\n    axes[1, 1].set_ylabel('Frequency')\n    axes[1, 1].set_title('Distribution of Items per Receipt')\n    \n    plt.tight_layout()\n    \n    # Save figure\n    output_path = f\"{output_dir}/receipt_visualizations.png\"\n    plt.savefig(output_path, dpi=150, bbox_inches='tight')\n    plt.show()\n    \n    print(f\"✓ Visualizations saved to {output_path}\")\n\n# Create visualizations if analyzer exists\nif 'analyzer' in locals() and analyzer is not None:\n    create_visualizations(analyzer.df)\nelse:\n    print(\"Visualization skipped: analyzer not available\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-20T17:23:50.294542Z","iopub.execute_input":"2026-03-20T17:23:50.295084Z","iopub.status.idle":"2026-03-20T17:23:51.508113Z","shell.execute_reply.started":"2026-03-20T17:23:50.295059Z","shell.execute_reply":"2026-03-20T17:23:51.507374Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x1000 with 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"✓ Visualizations saved to /kaggle/working/receipt_visualizations.png\n","output_type":"stream"}],"execution_count":8},{"cell_type":"markdown","source":"# Strategy: “Non-Invasive Upgrade Layer”","metadata":{}},{"cell_type":"code","source":"# ================================\n# PROFESSIONAL UPGRADE LAYER\n# ================================\n\nimport json\nfrom pprint import pprint\n\nclass ReceiptProcessor:\n\n    def __init__(self):\n        self.categories = {\n            \"food\": [\"restaurant\", \"cafe\", \"pizza\", \"burger\", \"dominos\", \"kfc\"],\n            \"groceries\": [\"mart\", \"store\", \"supermarket\", \"grocery\"],\n            \"travel\": [\"uber\", \"ola\", \"taxi\", \"flight\", \"bus\"],\n            \"shopping\": [\"mall\", \"amazon\", \"flipkart\", \"retail\"]\n        }\n\n    def format_output(self, raw_data):\n        return {\n            \"vendor\": raw_data.get(\"vendor\", \"\"),\n            \"date\": raw_data.get(\"date\", \"\"),\n            \"total\": raw_data.get(\"total\", 0.0),\n            \"items\": raw_data.get(\"items\", []),\n            \"category\": None,\n            \"confidence_score\": None\n        }\n\n    def categorize(self, vendor, items):\n        text = (vendor + \" \" + \" \".join(items)).lower()\n        for category, keywords in self.categories.items():\n            if any(k in text for k in keywords):\n                return category\n        return \"other\"\n\n    def compute_confidence(self, data):\n        score = 0\n        if data.get(\"vendor\"): score += 0.25\n        if data.get(\"date\"): score += 0.25\n        if data.get(\"total\"): score += 0.25\n        if data.get(\"items\"): score += 0.25\n        return round(score, 2)\n\n    def process(self, raw_output):\n        structured = self.format_output(raw_output)\n        structured[\"category\"] = self.categorize(\n            structured[\"vendor\"],\n            structured[\"items\"]\n        )\n        structured[\"confidence_score\"] = self.compute_confidence(structured)\n        return structured\n\n    def batch_process(self, receipts):\n        return [self.process(r) for r in receipts]\n\n    def evaluate(self, predictions, ground_truth):\n        correct = 0\n        total = len(predictions)\n\n        for pred, gt in zip(predictions, ground_truth):\n            if pred.get(\"total\") == gt.get(\"total\"):\n                correct += 1\n\n        accuracy = correct / total if total > 0 else 0\n        return {\"accuracy\": round(accuracy, 4)}\n\n    def save_json(self, data, filename=\"output.json\"):\n        with open(filename, \"w\") as f:\n            json.dump(data, f, indent=4)\n\n    def display(self, result):\n        print(\"\\n========== RECEIPT SUMMARY ==========\")\n        pprint(result)\n        print(\"====================================\\n\")\n\n\n# ================================\n# HOW TO USE (Example)\n# ================================\n\nprocessor = ReceiptProcessor()\n\n# Example: replace `raw_output` with your pipeline output\ntry:\n    final_result = processor.process(raw_output)\n    processor.display(final_result)\nexcept NameError:\n    print(\"Define 'raw_output' from your existing pipeline to use the processor.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-20T17:27:57.890057Z","iopub.execute_input":"2026-03-20T17:27:57.89074Z","iopub.status.idle":"2026-03-20T17:27:57.904381Z","shell.execute_reply.started":"2026-03-20T17:27:57.890705Z","shell.execute_reply":"2026-03-20T17:27:57.903406Z"}},"outputs":[{"name":"stdout","text":"Define 'raw_output' from your existing pipeline to use the processor.\n","output_type":"stream"}],"execution_count":9}]}